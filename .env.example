# Application Environment
NODE_ENV=development
NUXT_PUBLIC_API_BASE=http://localhost:3000/api
NUXT_PUBLIC_SITE_URL=http://localhost:3000
HOST=localhost
PORT=3000

# Database Configuration
DB_PATH=./database.sqlite

# API Keys (add your actual keys in .env, not here)
# NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here
# NUXT_PUBLIC_STRIPE_PUBLIC_KEY=your_key_here

# Authentication
# SESSION_SECRET=your_session_secret_here
# JWT_SECRET=your_jwt_secret_here

# Internationalization
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en

# Add your project-specific variables below
# API_URL=http://localhost:3000
# NUXT_PUBLIC_APP_NAME=SwissCar Export

# ── Admin notifications ──────────────────────────────────────────────────────
# Every signup, ID upload and auction request is ALWAYS recorded and shown in
# the admin panel's "Recent activity" panel — that works with none of the
# settings below configured. These add email/webhook delivery on top.
#
# Where to email the administrators. Comma-separated for several recipients.
# Needs RESEND_API_KEY as well; on its own it does nothing.
ADMIN_NOTIFICATION_EMAIL=admin@swisscarexport.ch

# Transport for those emails: a Resend (https://resend.com) API key.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address. Defaults to Resend's shared onboarding sender, which
# works immediately but should be replaced with your own verified domain.
# MAIL_FROM=SwissCarExport <noreply@swisscarexport.ch>

# Optional Slack / Discord / Zapier incoming webhook. Receives the same
# notifications as JSON, in addition to (or instead of) email.
# ADMIN_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
